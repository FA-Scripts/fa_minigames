  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "5.1.4",
    "fengari": "0.1.5",
    "typescript": "5.7.3",
    "vite": "7.3.6"
  }
}
